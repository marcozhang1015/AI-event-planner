{
  "name": "ai-event-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "demo": "bun run web:build && bun run start",
    "start": "bun src/index.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "reset-demo": "bun scripts/reset-demo.ts",
    "fetch-maps": "bun scripts/fetch-maps.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "hono": "^4.13.9",
    "spectrum-ts": "^12.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
