# 复制成 .env 再填。Bun 会自动读取 .env。启动时的 [preflight] 会提示漏填的项。

# 启用哪些 provider（逗号分隔）：sim（网页模拟器，/sim）、imessage、terminal
# 真手机和模拟器混着用：PROVIDERS=imessage,sim
PROVIDERS=sim
# PUBLIC_BASE_URL 是公网地址、又启用了 sim 时必须设，模拟器要带 ?key=... 才能用（否则拒绝启动）
SIM_KEY=

# Spectrum（Dashboard → Settings）；启用 imessage 时必填
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Claude。设 LLM=off 时全部走模板问题和规则解析，不调模型
ANTHROPIC_API_KEY=
LLM=on

# 地图：sample（虚构数据，默认）| cache（只读本机缓存）| live（请求 Google 并写缓存）
MAPS_MODE=sample
# 只在服务端用：Places、Routes，以及网页 / 邮件 / 链接预览里的静态地图（由 /map/:token.png 代理，不暴露给浏览器）
MAPS_SERVER_KEY=
# 地图搜索附加的地区，免得 "the library" 搜到别的城市，比如 St. Louis, MO
MAPS_REGION=

# 邮件：console（写进 data/outbox/*.eml，默认）。Day-0 选定服务商后再加 driver
EMAIL_DRIVER=console
EMAIL_FROM=Juno <juno@example.com>

# 网页。iMessage 里的链接和链接预览都要公网能访问：真机测试时填隧道或部署的域名
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# 活动时区（默认用本机时区）
EVENT_TZ=
# 夜间不主动给别人发消息（活动时区，默认 22-8），这段时间的邀请、通知会推迟到早上。demo 时设 off
QUIET_HOURS=22-8
# 每条收发的消息打一行日志（前 80 个字），真机测试时对照手机屏幕用。off 关掉
LOG_MESSAGES=on
